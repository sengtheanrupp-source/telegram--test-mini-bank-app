{
  "version": 2,
  "name": "telegram-mini-bank-payment-app",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/transaction/generatelinks",
      "destination": "/api/transaction/generatelinks"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://telegram.org;"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
